+def moveToTrash(filepath):
+    """Move a file to the OS trash instead of permanently deleting it."""
+    log.info("Moving to trash: %s" % filepath)
+    system = platform.system()
+    home_dir = os.path.expanduser("~")
+    if system == "Darwin":
+        trash_dir = os.path.join(home_dir, ".Trash")  # macOS: capital T
+    elif system == "Linux":
+        trash_dir = os.path.join(home_dir, ".local", "share", "Trash", "files")
+    else:
+        trash_dir = os.path.join(home_dir, ".trash")  # Windows fallback
+    if not os.path.exists(trash_dir):
+        log.error("Trash directory not found at %s — skipping deletion of original." % trash_dir)
+        return
+    filename = os.path.basename(filepath)
+    dest = os.path.join(trash_dir, filename)
+    i = 2
+    while os.path.exists(dest):
+        base, ext = os.path.splitext(filename)
+        dest = os.path.join(trash_dir, "%s.%d%s" % (base, i, ext))
+        i += 1
+    try:
+        shutil.move(filepath, dest)
+        log.info("Moved original to trash: %s" % dest)
+    except FileNotFoundError:
+        log.error("File not found when trying to trash: %s" % filepath)
+    except PermissionError:
+        log.error("Permission denied moving %s to trash." % filepath)
+    except Exception as e:
+        log.error("Unexpected error moving %s to trash: %s" % (filepath, e))
